# HTTPS for Eunomia: the `caddy` service in docker-compose.yml (profile
# "https") gets and renews a Let's Encrypt certificate for EUNOMIA_DOMAIN and
# proxies everything to the frontend, which forwards /api and /mcp to the
# backend. Turn it on from Settings → HTTPS or the installer's --domain flag;
# see docs/deployment.md.
{
	email {$EUNOMIA_ACME_EMAIL}
}

{$EUNOMIA_DOMAIN} {
	reverse_proxy frontend:3000
}
