# copy to .env and fill in before `docker compose up`
SECRET_KEY=
ENCRYPTION_KEY=
# Static bearer token for the API + MCP surface. Leave blank for open access on a
# trusted network; set it (any long random string) and Eunomia rejects unauthed
# calls. Bind the service to the tailscale/netbird interface, not 0.0.0.0.
EUNOMIA_API_TOKEN=
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must equal EUNOMIA_API_TOKEN when that is set (the admin frontend sends it).
NEXT_PUBLIC_API_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback
