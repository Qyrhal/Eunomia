  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default compact button: raised graphite, hairline edge, 0.97 press.",
      "html": "<button class=\"ds-btn\">Sync now</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border-radius:var(--radius-control);font:500 13px/1 var(--font-sans),system-ui,sans-serif;white-space:nowrap;border:var(--hair) solid var(--border-strong);background:var(--surface-raised);color:var(--ink);cursor:pointer;transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-hover) ease, border-color var(--dur-hover) ease;} .ds-btn:hover{background:var(--surface-hover);} .ds-btn:active{transform:scale(0.97);} .ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action per view, felt green.",
      "html": "<button class=\"ds-btn-primary\">Generate a token</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border-radius:var(--radius-control);font:500 13px/1 var(--font-sans),system-ui,sans-serif;white-space:nowrap;border:var(--hair) solid var(--border-strong);background:var(--surface-raised);color:var(--ink);cursor:pointer;transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-hover) ease, border-color var(--dur-hover) ease;background:var(--accent);border-color:transparent;color:var(--on-accent);} .ds-btn-primary:hover{background:color-mix(in oklab, var(--accent) 88%, var(--ink));} .ds-btn-primary:active{transform:scale(0.97);} .ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet toolbar and footer action.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border-radius:var(--radius-control);font:500 13px/1 var(--font-sans),system-ui,sans-serif;white-space:nowrap;border:var(--hair) solid var(--border-strong);background:var(--surface-raised);color:var(--ink);cursor:pointer;transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-hover) ease, border-color var(--dur-hover) ease;background:transparent;border-color:transparent;color:var(--ink-dim);} .ds-btn-ghost:hover{color:var(--ink);background:var(--surface-hover);} .ds-btn-ghost:active{transform:scale(0.97);} .ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action; HoldButton adds a hold-to-confirm wash.",
      "html": "<button class=\"ds-btn-danger\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h18\"/><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\"/><path d=\"M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/></svg>Delete vault</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border-radius:var(--radius-control);font:500 13px/1 var(--font-sans),system-ui,sans-serif;white-space:nowrap;border:var(--hair) solid var(--border-strong);background:var(--surface-raised);color:var(--ink);cursor:pointer;transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-hover) ease, border-color var(--dur-hover) ease;background:transparent;color:var(--critical);} .ds-btn-danger:hover{background:var(--critical-soft);} .ds-btn-danger:active{transform:scale(0.97);} .ds-btn-danger:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Single-line input; the border turns felt green on focus.",
      "html": "<input class=\"ds-field\" placeholder=\"http://localhost:3417/mcp\" />",
      "css": ".ds-field{height:32px;padding:0 12px;background:var(--surface-raised);border:var(--hair) solid var(--border);border-radius:var(--radius-field);color:var(--ink);font:13px var(--font-sans),system-ui,sans-serif;transition:border-color var(--dur-hover) ease, background-color var(--dur-hover) ease;} .ds-field::placeholder{color:var(--ink-faint);} .ds-field:focus{border-color:var(--accent);outline:none;}"
    },
    {
      "name": "Filter Pills",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Multi-select filters go neutral when on; single-choice selection takes the accent.",
      "html": "<div class=\"ds-pills\"><button class=\"ds-pill\" aria-pressed=\"true\">Person</button><button class=\"ds-pill\" aria-pressed=\"false\">Location</button><button class=\"ds-pill\" aria-selected=\"true\">General</button></div>",
      "css": ".ds-pills{display:flex;gap:6px;} .ds-pill{display:inline-flex;align-items:center;height:24px;padding:0 9px;border-radius:6px;border:var(--hair) solid var(--border);background:var(--surface-raised);color:var(--ink-dim);font:12px/1 var(--font-sans),system-ui,sans-serif;cursor:pointer;transition:transform var(--dur-press) var(--ease-out), border-color var(--dur-hover) ease, color var(--dur-hover) ease;} .ds-pill:active{transform:scale(0.97);} .ds-pill[aria-pressed=\"true\"]{border-color:var(--border-strong);background:var(--surface-hover);color:var(--ink);} .ds-pill[aria-pressed=\"false\"]{opacity:0.7;} .ds-pill[aria-selected=\"true\"]{border-color:var(--accent);background:var(--accent-soft);color:var(--ink);} .ds-pill:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Author Tag",
      "kind": "custom",
      "refersTo": "author-tag",
      "description": "Figma-style multiplayer name tag with an optional cursor glyph; author colours mark authorship only.",
      "html": "<span class=\"ds-author\"><svg class=\"ds-author-cursor\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M2 1.5 13.5 7 8.3 8.4 6 13.8Z\" fill=\"var(--author-2)\" stroke=\"var(--canvas)\" stroke-width=\"1\" stroke-linejoin=\"round\"/></svg><span class=\"ds-author-tag\" style=\"--author:var(--author-2)\">Claude Code laptop</span></span> <span class=\"ds-author-tag\" style=\"--author:var(--author-3)\">design</span>",
      "css": ".ds-author{position:relative;display:inline-flex;} .ds-author-cursor{position:absolute;left:-8px;top:-12px;pointer-events:none;} .ds-author-tag{display:inline-flex;align-items:center;height:20px;padding:0 6px;border-radius:4px 4px 4px 1px;background:var(--author, var(--ink-faint));color:var(--on-author);font:500 11.5px/1 var(--font-sans),system-ui,sans-serif;white-space:nowrap;}"
    },
    {
      "name": "Selection Frame Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Floating inspector panel wearing the selection frame: accent outline plus four square handles.",
      "html": "<aside class=\"ds-panel ds-selected\"><div class=\"ds-title\">Shared components live in packages/ui.</div><div class=\"ds-label\">Author</div></aside>",
      "css": ".ds-panel{background:var(--surface);border-radius:var(--radius-card);box-shadow:var(--shadow-panel);padding:16px;display:flex;flex-direction:column;gap:12px;max-width:320px;} .ds-title{font:600 13px var(--font-sans),system-ui,sans-serif;color:var(--ink);} .ds-label{font-size:12px;color:var(--ink-faint);} .ds-selected{position:relative;outline:1px solid var(--accent);outline-offset:-1px;} .ds-selected::after{content:\"\";position:absolute;inset:-3px;pointer-events:none;background:linear-gradient(var(--accent),var(--accent)) top left/6px 6px no-repeat,linear-gradient(var(--accent),var(--accent)) top right/6px 6px no-repeat,linear-gradient(var(--accent),var(--accent)) bottom left/6px 6px no-repeat,linear-gradient(var(--accent),var(--accent)) bottom right/6px 6px no-repeat;}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Nav rows: raised fill when active or hovered, active icon in felt green.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link\" data-active href=\"#\"><svg class=\"ds-nav-icon\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg>Dashboard</a><a class=\"ds-nav-link\" href=\"#\"><svg class=\"ds-nav-icon\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>Chat</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:1px;width:208px;padding:12px;background:var(--surface);} .ds-nav-link{display:flex;align-items:center;gap:10px;height:32px;padding:0 10px;border-radius:7px;font:13px var(--font-sans),system-ui,sans-serif;color:var(--ink-dim);text-decoration:none;transition:background-color var(--dur-hover) ease,color var(--dur-hover) ease;} .ds-nav-link .ds-nav-icon{color:var(--ink-faint);} .ds-nav-link:hover,.ds-nav-link[data-active]{background:var(--surface-raised);color:var(--ink);} .ds-nav-link[data-active]{font-weight:500;} .ds-nav-link[data-active] .ds-nav-icon{color:var(--accent-text);} .ds-nav-link:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
