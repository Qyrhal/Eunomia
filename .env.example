# copy to .env and fill in before `docker compose up`

# Static bearer token for the API + MCP surface. Leave blank for open access on a
# trusted network; set it (any long random string) and Eunomia rejects unauthed
# calls. Bind the service to the tailscale/netbird interface, not 0.0.0.0.
EUNOMIA_API_TOKEN=

# Fernet key for connector credential encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=eunomia
SURREAL_DB=eunomia

OPENAI_API_KEY=

# Only selectable here, never from the DB -- "stub" is for hermetic tests only.
EMBEDDINGS_BACKEND=openai

FRONTEND_URL=http://localhost:3000
