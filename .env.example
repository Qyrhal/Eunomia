# copy to .env and fill in before `docker compose up`

# Signs browser-session JWTs. Leave blank for local dev (a random secret is
# generated at process startup, but sessions won't survive a restart) --
# set it explicitly for anything long-running or multi-process.
JWT_SECRET=

# Required (at least 16 characters): AES-256-GCM key for saved connector
# credentials and API keys. The backend refuses to start without one.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=eunomia
SURREAL_DB=eunomia

# Optional. A connected AI agent (MCP) can recall and write memory with its own
# model; an OpenAI-compatible endpoint is recommended to save its tokens (Eunomia
# then does embeddings and answer synthesis itself, and powers the in-app chat).
# 1. Endpoint. The default for every user (each can point Settings at their
# own) -- point this at a self-hosted/alternate provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Key (blank is fine for a self-hosted endpoint that needs none). Only ever
# sent to OPENAI_BASE_URL: a user who picks another base URL in Settings uses
# their own key there, never this one.
OPENAI_API_KEY=

# Only selectable here, never from the DB -- "stub" is for hermetic tests only.
EMBEDDINGS_BACKEND=openai

# Browser origin allowed to make credentialed (cookie-session) requests to the
# backend API. Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:3000

FRONTEND_URL=http://localhost:3000

# eunomia.* logger level: DEBUG/INFO/WARNING/ERROR/CRITICAL.
LOG_LEVEL=INFO

# Host ports docker-compose publishes the containers on (container-internal
# ports stay 8001/3000 either way).
BACKEND_PORT=8001
FRONTEND_PORT=3000

# Release whose prebuilt images run (set by the installer, bumped by
# scripts/auto-update.sh when you click "Update now" in Settings).
EUNOMIA_IMAGE_TAG=latest

# HTTPS with a free Let's Encrypt certificate (the `caddy` service, see
# ./Caddyfile). Needs a domain whose DNS points at this machine and ports
# 80/443 reachable from the internet. Set by the installer's --domain /
# --acme-email flags or Settings → HTTPS; by hand, uncomment all three and
# run `docker compose up -d`.
# COMPOSE_PROFILES=https
# EUNOMIA_DOMAIN=eunomia.example.com
# EUNOMIA_ACME_EMAIL=you@example.com
