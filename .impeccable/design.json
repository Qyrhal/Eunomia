      "refersTo": "table-cell",
      "description": "Dense hairline table with tabular numerals and quiet headers.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Source</th><th>Records</th></tr></thead><tbody><tr><td>Demo data</td><td class=\"ds-mono\">77</td></tr><tr><td>GitHub</td><td class=\"ds-mono\">1,204</td></tr></tbody></table>",
      "css": ".ds-table{width:100%;border-collapse:collapse;font:13px var(--font-sans),system-ui,sans-serif;color:var(--ink);background:var(--surface);} .ds-table th{height:32px;padding:0 12px;text-align:left;font-weight:500;font-size:12px;color:var(--ink-faint);border-bottom:var(--hair) solid var(--border);} .ds-table td{height:40px;padding:0 12px;border-bottom:var(--hair) solid var(--border);font-variant-numeric:tabular-nums;} .ds-table tr:last-child td{border-bottom:0;} .ds-table tbody tr:hover td{background:var(--surface-raised);} .ds-mono{font-family:var(--font-mono),ui-monospace,monospace;}"
    }
