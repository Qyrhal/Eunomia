# copy to .env and fill in before `docker compose up`

# Signs browser-session JWTs. Leave blank for local dev (a random secret is
# generated at process startup, but sessions won't survive a restart) --
# set it explicitly for anything long-running or multi-process.
JWT_SECRET=

# Fernet key for connector credential encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=eunomia
SURREAL_DB=eunomia

OPENAI_API_KEY=

# Only selectable here, never from the DB -- "stub" is for hermetic tests only.
EMBEDDINGS_BACKEND=openai

# Browser origin allowed to make credentialed (cookie-session) requests to the
# backend API. Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:3000

FRONTEND_URL=http://localhost:3000

# API base URL baked into the frontend at build time (Next.js public env vars
# are compiled in, not read at runtime) -- must be the browser-reachable URL,
# not an internal docker-compose service name.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Personal API token for the mcp service, minted per-user via
# `POST /api/auth/token` after registering through the web UI. Each MCP
# connection resolves to exactly one owner via this token.
EUNOMIA_API_TOKEN=
